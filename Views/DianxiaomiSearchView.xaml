<UserControl x:Class="EcommerceWorkbench.Views.DianxiaomiSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardStyle}"
                CornerRadius="0"
                BorderThickness="0,0,0,1"
                Padding="18,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="店小秘连接"
                           Style="{StaticResource SectionTitleStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>
                <WrapPanel HorizontalAlignment="Right">
                    <Button x:Name="ToggleBrowserButton"
                            Content="隐藏浏览器"
                            Click="ToggleBrowser_Click"
                            Background="{StaticResource OkGreenBrush}"
                            IsEnabled="False"/>
                    <Button x:Name="OpenLoginButton"
                            Content="打开登录页"
                            Click="OpenLogin_Click"/>
                    <Button x:Name="ExportCookiesButton"
                            Content="导出 Cookie"
                            Click="ExportCookies_Click"
                            IsEnabled="False"/>
                    <Button x:Name="SaveCookiesButton"
                            Content="保存到本地"
                            Click="SaveCookies_Click"/>
                    <Button Content="加载本地" Click="LoadCookies_Click"/>
                    <Button Content="清空会话" Click="ClearSession_Click" Style="{StaticResource GhostButton}" Margin="0"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <Grid x:Name="ContentGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="BrowserColumn" Width="0"/>
                <ColumnDefinition x:Name="SplitterColumn" Width="0"/>
                <ColumnDefinition x:Name="WorkColumn" Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="BrowserPanel"
                    Grid.Column="0"
                    Visibility="Collapsed"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="1. 登录专用浏览器（仅用于输入账号密码与验证码）"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               Margin="4,4,4,8"/>
                    <Grid x:Name="BrowserHost"/>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="BrowserSplitter"
                          Grid.Column="1"
                          Width="12"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"/>

            <Border x:Name="WorkPanel"
                    Grid.Column="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="当前 Cookie（短期会话）"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="CookiePreviewBox"
                                 Height="44"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 IsReadOnly="True"
                                 Margin="0,0,0,10"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top"
                                       Text="商品搜索"
                                       Style="{StaticResource SectionTitleStyle}"
                                       Margin="0,0,0,6"/>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="逗号/换行分隔；单次最多 200 个，只发一次请求；命中按输入顺序展示"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,0,6"
                                       TextWrapping="Wrap"/>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <Button Content="搜索商品"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,6"
                                        Click="SearchProducts_Click"/>
                                <TextBlock x:Name="RequestStatusText"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                            <TextBox x:Name="SearchValueBox"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"/>
                        </DockPanel>

                        <DockPanel Grid.Column="2">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <TextBlock Text="命中结果"
                                           Style="{StaticResource SectionTitleStyle}"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="HitCountText"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}"
                                           Text="0 条"/>
                                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="导入到定价"
                                            Style="{StaticResource OrangeButton}"
                                            Margin="0,0,6,0"
                                            Click="ImportToPricing_Click"/>
                                    <Button Content="JOOM计算"
                                            Background="{StaticResource OkGreenBrush}"
                                            Margin="0,0,6,0"
                                            Click="ImportToJoom_Click"/>
                                    <Button Content="速卖通7计算"
                                            Background="{StaticResource OkGreenBrush}"
                                            Margin="0,0,6,0"
                                            Click="ImportToSmt7_Click"/>
                                    <Button Content="复制SKU和价格"
                                            Background="{StaticResource AccentBrush}"
                                            Margin="0,0,6,0"
                                            Click="CopySkuPrice_Click"/>
                                    <Button Content="复制SKU、价格和重量"
                                            Background="{StaticResource AccentBrush}"
                                            Margin="0"
                                            Click="CopySkuPriceWeight_Click"/>
                                </WrapPanel>
                            </DockPanel>
                            <DataGrid x:Name="ResultGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeColumns="True"
                                      CanUserSortColumns="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderBrush="{StaticResource BorderBrush}"
                                      BorderThickness="1"
                                      RowHeight="32"
                                      EnableRowVirtualization="True"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Resources>
                                    <Style x:Key="WideHeaderStyle" TargetType="DataGridColumnHeader">
                                        <Setter Property="Padding" Value="8,8"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="MinHeight" Value="36"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    </Style>
                                    <Style x:Key="CellTextStyle" TargetType="TextBlock">
                                        <Setter Property="Padding" Value="6,4"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
                                        <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource WideHeaderStyle}"/>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SKU"
                                                        Binding="{Binding Sku}"
                                                        Width="*"
                                                        MinWidth="80"
                                                        ElementStyle="{StaticResource CellTextStyle}"/>
                                    <DataGridTextColumn Header="参考价（￥）"
                                                        Binding="{Binding Price, StringFormat={}{0:0.00}}"
                                                        Width="*"
                                                        MinWidth="80"
                                                        ElementStyle="{StaticResource CellTextStyle}"/>
                                    <DataGridTextColumn Header="重量"
                                                        Binding="{Binding Weight}"
                                                        Width="*"
                                                        MinWidth="60"
                                                        ElementStyle="{StaticResource CellTextStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <DockPanel Grid.Column="4">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <TextBlock Text="未命中 SKU"
                                           Style="{StaticResource SectionTitleStyle}"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="MissCountText"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource WarnAmberBrush}"
                                           Text="0 个"/>
                                <Button DockPanel.Dock="Right"
                                        Content="复制未命中"
                                        Background="{StaticResource WarnAmberBrush}"
                                        Margin="0"
                                        Click="CopyMissedSkus_Click"/>
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="输入值未匹配到商品"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,0,6"
                                       TextWrapping="Wrap"/>
                            <ListBox x:Name="MissedSkuList"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     BorderThickness="1"
                                     Padding="4"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Padding="4,3"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
