<UserControl x:Class="EcommerceWorkbench.Views.ShopeePricingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:EcommerceWorkbench.Converters">
    <UserControl.Resources>
        <conv:NullableDoubleConverter x:Key="NullableDouble"/>
        <Style x:Key="InputCell" TargetType="TextBlock">
            <Setter Property="Background" Value="{StaticResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="6,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="InputEdit" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="SelectionBrush" Value="#BBDEFB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ResultCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
        </Style>
        <Style x:Key="KeyResultCell" TargetType="TextBlock" BasedOn="{StaticResource ResultCell}">
            <Setter Property="Background" Value="{StaticResource KeyResultBgBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="ParamBox" TargetType="TextBox">
            <Setter Property="Width" Value="88"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <StackPanel>
                <TextBlock Text="跨境商品定价 · 批量计算"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="填写 SKU（唯一键）、成本价、重量 · 默认净利润率变更后同步计算售价"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,4,0,8"/>
                <WrapPanel x:Name="TagPanel" Margin="0,0,0,4"/>
                <TextBlock x:Name="RateSourceText"
                           Foreground="{StaticResource MutedBrush}"
                           Text="运费来源：嵌入缓存"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,10"
                Margin="0,10,0,8">
            <StackPanel>
                <TextBlock Text="全局参数 · 汇率可手动维护（修改后自动保存到本机）"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,0,0,8"/>
                <WrapPanel>
                    <Border Background="#FFF3E0" Padding="10,8" Margin="0,0,14,8" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="汇率 CNY→TWD（手动维护）"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBox x:Name="RateBox" Width="110" Text="4.77"
                                         HorizontalContentAlignment="Right"
                                         LostFocus="Param_LostFocus"/>
                                <Button Content="保存汇率" Style="{StaticResource SecondaryButton}"
                                        Margin="8,0,0,0" Click="SaveRate_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="RateSavedLabel" Foreground="{StaticResource OkGreenBrush}" Text="未保存"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="0,0,14,8">
                        <TextBlock Text="折扣 %OFF" Style="{StaticResource ParamLabel}"/>
                        <TextBox x:Name="DiscountBox" Style="{StaticResource ParamBox}" Text="30" LostFocus="Param_LostFocus"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,8">
                        <TextBlock Text="境内运费 CNY" Style="{StaticResource ParamLabel}"/>
                        <TextBox x:Name="DomesticBox" Style="{StaticResource ParamBox}" Text="1" LostFocus="Param_LostFocus"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,8">
                        <TextBlock Text="活动服务费 %" Style="{StaticResource ParamLabel}"/>
                        <TextBox x:Name="ActivityBox" Style="{StaticResource ParamBox}" Text="1" LostFocus="Param_LostFocus"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,8">
                        <TextBlock Text="提现手续费 %" Style="{StaticResource ParamLabel}"/>
                        <TextBox x:Name="WithdrawBox" Style="{StaticResource ParamBox}" Text="1" LostFocus="Param_LostFocus"/>
                    </StackPanel>
                    <Border Background="#FFF8E6" Padding="10,8" Margin="0,0,14,8" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="默认预期净利润率 %" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                            <TextBox x:Name="DefaultProfitRateBox" Width="110" HorizontalContentAlignment="Right"
                                     LostFocus="DefaultProfitRate_LostFocus"
                                     ToolTip="须与官网「预期净利润率」完全一致（两位小数）。30 与 30.01 的折前售价、站点调价比例会不同。官网请选「通过输入预期净利润率，计算售价和净利润」。"/>
                        </StackPanel>
                    </Border>
                    <CheckBox x:Name="AutoCalcCheck"
                              Content="参数变更后自动计算"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Margin="8,22,0,8"
                              Checked="AutoCalc_Changed"
                              Unchecked="AutoCalc_Changed"/>
                </WrapPanel>
                <WrapPanel Margin="0,4,0,0">
                    <Button Content="批量计算 (F5)" Style="{StaticResource OrangeButton}" Click="Calc_Click"
                            ToolTip="按「默认预期净利润率」倒推各行售价与费用"/>
                    <Button Content="重计算" Style="{StaticResource SecondaryButton}" Click="RecalcOfficial_Click"
                            ToolTip="按官网默认逻辑：用各行「预期净利润」金额计算售价和净利润率，不按默认净利润率倒推"/>
                    <Button Content="刷新费率" Style="{StaticResource SecondaryButton}" x:Name="RefreshButton" Click="Refresh_Click"/>
                    <Button Content="添加行" Style="{StaticResource GhostButton}" Click="AddRow_Click"/>
                    <Button Content="删除选中" Style="{StaticResource GhostButton}" Click="Delete_Click"/>
                    <Button Content="清空输入" Style="{StaticResource GhostButton}" Click="ClearInput_Click"/>
                    <Button Content="清空结果" Style="{StaticResource GhostButton}" Click="ClearResult_Click"/>
                    <Button Content="导出 CSV" Style="{StaticResource SuccessButton}" Click="Export_Click" Margin="0"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <DataGrid x:Name="PricingGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserSortColumns="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      FrozenColumnCount="6"
                      CanUserReorderColumns="False"
                      RowHeight="34"
                      AlternatingRowBackground="#FAFBFD"
                      BorderThickness="0"
                      EnableRowVirtualization="True"
                      SelectionUnit="Cell"
                      SelectionMode="Extended"
                      PreviewKeyDown="PricingGrid_PreviewKeyDown"
                      CellEditEnding="PricingGrid_CellEditEnding">
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#D6E8FF"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1B2430"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#D6E8FF"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1B2430"/>
                </DataGrid.Resources>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter VerticalAlignment="Stretch"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#D6E8FF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEditing" Value="True">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Padding" Value="8,8"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="MinHeight" Value="40"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Index}" IsReadOnly="True" Width="44"/>
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku, UpdateSourceTrigger=LostFocus}" Width="160"
                                        ElementStyle="{StaticResource InputCell}"
                                        EditingElementStyle="{StaticResource InputEdit}"/>
                    <DataGridTextColumn Header="商品成本价 CNY"
                                        Binding="{Binding Cost, Converter={StaticResource NullableDouble}, UpdateSourceTrigger=LostFocus}"
                                        Width="120"
                                        ElementStyle="{StaticResource InputCell}"
                                        EditingElementStyle="{StaticResource InputEdit}"/>
                    <DataGridTextColumn Header="包裹重量 g"
                                        Binding="{Binding Weight, Converter={StaticResource NullableDouble}, UpdateSourceTrigger=LostFocus}"
                                        Width="110"
                                        ElementStyle="{StaticResource InputCell}"
                                        EditingElementStyle="{StaticResource InputEdit}"/>
                    <DataGridTextColumn Header="预期净利润 CNY"
                                        Binding="{Binding ExpectedProfit, Converter={StaticResource NullableDouble}, UpdateSourceTrigger=LostFocus}"
                                        Width="130"
                                        ElementStyle="{StaticResource InputCell}"
                                        EditingElementStyle="{StaticResource InputEdit}"/>
                    <DataGridTextColumn Header="折前售价" Binding="{Binding PriceBeforeDiscount}" IsReadOnly="True" Width="100"
                                        ElementStyle="{StaticResource KeyResultCell}"/>
                    <DataGridTextColumn Header="商品售价（折后售价）" Binding="{Binding DiscountedPrice}" IsReadOnly="True" MinWidth="160"
                                        ElementStyle="{StaticResource KeyResultCell}"/>
                    <DataGridTextColumn Header="净利润率" Binding="{Binding ProfitRate}" IsReadOnly="True" Width="90"
                                        ElementStyle="{StaticResource ResultCell}"/>
                    <DataGridTextColumn Header="订单收入" Binding="{Binding OrderRevenue}" IsReadOnly="True" Width="100"
                                        ElementStyle="{StaticResource ResultCell}"/>
                    <DataGridTextColumn Header="站点调价比例" Binding="{Binding AdjRate}" IsReadOnly="True" Width="110"
                                        ElementStyle="{StaticResource KeyResultCell}"/>
                    <DataGridTextColumn Header="佣金" Binding="{Binding Commission}" IsReadOnly="True" Width="80"
                                        ElementStyle="{StaticResource ResultCell}"/>
                    <DataGridTextColumn Header="交易手续费" Binding="{Binding TradeHf}" IsReadOnly="True" Width="100"
                                        ElementStyle="{StaticResource ResultCell}"/>
                    <DataGridTextColumn Header="活动服务费" Binding="{Binding ActivitySc}" IsReadOnly="True" Width="100"
                                        ElementStyle="{StaticResource ResultCell}"/>
                    <DataGridTextColumn Header="卖家支付运费" Binding="{Binding SellerSf}" IsReadOnly="True" Width="110"
                                        ElementStyle="{StaticResource ResultCell}"/>
                    <DataGridTextColumn Header="跨境物流成本（藏价）" Binding="{Binding HiddenFee}" IsReadOnly="True" MinWidth="160"
                                        ElementStyle="{StaticResource ResultCell}"/>
                    <DataGridTextColumn Header="买家支付运费" Binding="{Binding BuyerSf}" IsReadOnly="True" Width="110"
                                        ElementStyle="{StaticResource ResultCell}"/>
                    <DataGridTextColumn Header="提现手续费" Binding="{Binding WithdrawHf}" IsReadOnly="True" Width="100"
                                        ElementStyle="{StaticResource ResultCell}"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" IsReadOnly="True" Width="160">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="6,2"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="OK">
                                        <Setter Property="Foreground" Value="{StaticResource OkGreenBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="3"
                   Margin="4,8,4,0"
                   Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap"
                   Text="提示：黄色列为可编辑 · SKU 为行唯一键 · F5 按默认净利润率倒推 · 「重计算」按官网用各行预期净利润计算 · Ctrl+E 导出"/>
    </Grid>
</UserControl>
