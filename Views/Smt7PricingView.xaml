<UserControl x:Class="EcommerceWorkbench.Views.Smt7PricingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:EcommerceWorkbench.Converters">
    <UserControl.Resources>
        <conv:NullableDoubleConverter x:Key="NullableDouble"/>
        <Style x:Key="InputCell" TargetType="TextBlock">
            <Setter Property="Background" Value="{StaticResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="6,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="InputEdit" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="SelectionBrush" Value="#BBDEFB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ResultCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
        </Style>
        <Style x:Key="ReadSkuCell" TargetType="TextBlock" BasedOn="{StaticResource ResultCell}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="Padding" Value="6,6"/>
        </Style>
        <Style x:Key="KeyResultCell" TargetType="TextBlock" BasedOn="{StaticResource ResultCell}">
            <Setter Property="Background" Value="{StaticResource KeyResultBgBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="ParamBox" TargetType="TextBox">
            <Setter Property="Width" Value="58"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="ParamHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,6,4"/>
        </Style>
        <!-- 与 JOOM 页同款折叠头样式；JOOM 那份定义在 JoomPricingView 自己的资源里，
             跨 UserControl 取不到，所以这里各自留一份。 -->
        <Style x:Key="SectionExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Content="{TemplateBinding Header}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          HorizontalContentAlignment="Stretch"
                                          Cursor="Hand"
                                          Focusable="False"
                                          Padding="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="0,1">
                                            <DockPanel>
                                                <TextBlock x:Name="Chevron"
                                                           DockPanel.Dock="Left"
                                                           Text="▶"
                                                           Width="16"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Expander}}"/>
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                  VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="Text" Value="▼"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Margin="0,8,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="PageScroll"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PreviewMouseWheel="PageScroll_PreviewMouseWheel">
    <Grid Margin="14,10,14,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="速卖通7 批量定价"
                       Style="{StaticResource PageTitleStyle}"
                       VerticalAlignment="Center"/>
            <TextBlock Text="读取变种 SKU → 搜索参考价 → 按全托2.0计算 → 回写供货价"
                       Style="{StaticResource PageDescriptionStyle}"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <Border Grid.Row="1"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,10"
                Margin="0,0,0,8">
            <StackPanel>
                <Expander Style="{StaticResource SectionExpander}"
                          IsExpanded="False">
                    <Expander.Header>
                        <TextBlock Text="分档参数 · 默认对齐全托2.0（展开后可维护成本分档与重量加价）"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                <TextBlock Text="公式对齐计算表「全托2.0」：零售价 = ROUND((成本/分子1 + 常量)/分子2, 2)；最终价 = ROUND(零售价 + 重量加价, 2)。换算重量取详情页【货品信息】重量(kg)，按货品条码与【变种信息】唯一匹配；重量(g) = kg×1000。搜索只填充成本。修改分档后失焦即保存并重算。"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>
                <WrapPanel>
                    <Border Background="{StaticResource AccentSoftBrush}" Padding="12,10" Margin="0,0,10,8" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="成本分档（成本上限&lt; 不含本档，最后一档为其余）"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="成本上限&lt;" Style="{StaticResource ParamHeader}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="分子1" Style="{StaticResource ParamHeader}"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="常量" Style="{StaticResource ParamHeader}"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="分子2" Style="{StaticResource ParamHeader}"/>
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="毛利% (仅参考)" Style="{StaticResource ParamHeader}"
                                           ToolTip="此列只作展示，不参与全托2.0 公式。售价只由分子1/常量/分子2 与重量加价决定。"/>

                                <TextBox x:Name="CostMaxBox1" Grid.Row="1" Grid.Column="0" Style="{StaticResource ParamBox}" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostFactor1Box1" Grid.Row="1" Grid.Column="1" Style="{StaticResource ParamBox}" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostConstBox1" Grid.Row="1" Grid.Column="2" Style="{StaticResource ParamBox}" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostFactor2Box1" Grid.Row="1" Grid.Column="3" Style="{StaticResource ParamBox}" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostMarginBox1" Grid.Row="1" Grid.Column="4" Style="{StaticResource ParamBox}" LostFocus="Param_LostFocus"/>

                                <TextBox x:Name="CostMaxBox2" Grid.Row="2" Grid.Column="0" Style="{StaticResource ParamBox}" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostFactor1Box2" Grid.Row="2" Grid.Column="1" Style="{StaticResource ParamBox}" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostConstBox2" Grid.Row="2" Grid.Column="2" Style="{StaticResource ParamBox}" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostFactor2Box2" Grid.Row="2" Grid.Column="3" Style="{StaticResource ParamBox}" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostMarginBox2" Grid.Row="2" Grid.Column="4" Style="{StaticResource ParamBox}" LostFocus="Param_LostFocus"/>

                                <TextBox x:Name="CostMaxBox3" Grid.Row="3" Grid.Column="0" Style="{StaticResource ParamBox}" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostFactor1Box3" Grid.Row="3" Grid.Column="1" Style="{StaticResource ParamBox}" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostConstBox3" Grid.Row="3" Grid.Column="2" Style="{StaticResource ParamBox}" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostFactor2Box3" Grid.Row="3" Grid.Column="3" Style="{StaticResource ParamBox}" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostMarginBox3" Grid.Row="3" Grid.Column="4" Style="{StaticResource ParamBox}" LostFocus="Param_LostFocus"/>

                                <TextBox x:Name="CostMaxBox4" Grid.Row="4" Grid.Column="0" Style="{StaticResource ParamBox}" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostFactor1Box4" Grid.Row="4" Grid.Column="1" Style="{StaticResource ParamBox}" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostConstBox4" Grid.Row="4" Grid.Column="2" Style="{StaticResource ParamBox}" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostFactor2Box4" Grid.Row="4" Grid.Column="3" Style="{StaticResource ParamBox}" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostMarginBox4" Grid.Row="4" Grid.Column="4" Style="{StaticResource ParamBox}" LostFocus="Param_LostFocus"/>

                                <TextBox x:Name="CostMaxBox5" Grid.Row="5" Grid.Column="0" Style="{StaticResource ParamBox}" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostFactor1Box5" Grid.Row="5" Grid.Column="1" Style="{StaticResource ParamBox}" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostConstBox5" Grid.Row="5" Grid.Column="2" Style="{StaticResource ParamBox}" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostFactor2Box5" Grid.Row="5" Grid.Column="3" Style="{StaticResource ParamBox}" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostMarginBox5" Grid.Row="5" Grid.Column="4" Style="{StaticResource ParamBox}" LostFocus="Param_LostFocus"/>

                                <TextBox Grid.Row="6" Grid.Column="0" Style="{StaticResource ParamBox}" Text="其余" IsReadOnly="True"
                                         HorizontalContentAlignment="Center" Background="#EEF2F6"/>
                                <TextBox x:Name="CostFactor1Box6" Grid.Row="6" Grid.Column="1" Style="{StaticResource ParamBox}" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostConstBox6" Grid.Row="6" Grid.Column="2" Style="{StaticResource ParamBox}" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostFactor2Box6" Grid.Row="6" Grid.Column="3" Style="{StaticResource ParamBox}" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostMarginBox6" Grid.Row="6" Grid.Column="4" Style="{StaticResource ParamBox}" LostFocus="Param_LostFocus"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource SurfaceAltBrush}" Padding="12,10" Margin="0,0,10,8" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="重量加价（换算重量 kg，上限不含本档）"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="换算重量&lt;(kg)" Style="{StaticResource ParamHeader}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="加价" Style="{StaticResource ParamHeader}"/>

                                <TextBox x:Name="WeightMaxBox1" Grid.Row="1" Grid.Column="0" Style="{StaticResource ParamBox}" Width="88" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="WeightMarkupBox1" Grid.Row="1" Grid.Column="1" Style="{StaticResource ParamBox}" LostFocus="Param_LostFocus"/>

                                <TextBox x:Name="WeightMaxBox2" Grid.Row="2" Grid.Column="0" Style="{StaticResource ParamBox}" Width="88" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="WeightMarkupBox2" Grid.Row="2" Grid.Column="1" Style="{StaticResource ParamBox}" LostFocus="Param_LostFocus"/>

                                <TextBox x:Name="WeightMaxBox3" Grid.Row="3" Grid.Column="0" Style="{StaticResource ParamBox}" Width="88" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="WeightMarkupBox3" Grid.Row="3" Grid.Column="1" Style="{StaticResource ParamBox}" LostFocus="Param_LostFocus"/>

                                <TextBox Grid.Row="4" Grid.Column="0" Style="{StaticResource ParamBox}" Width="88" Text="其余" IsReadOnly="True"
                                         HorizontalContentAlignment="Center" Background="#EEF2F6"/>
                                <TextBox x:Name="WeightMarkupBox4" Grid.Row="4" Grid.Column="1" Style="{StaticResource ParamBox}" LostFocus="Param_LostFocus"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="8,8,0,8">
                        <CheckBox x:Name="AutoCalcCheck"
                                  Content="参数变更后自动计算"
                                  IsChecked="True"
                                  Margin="0,0,0,8"/>
                        <Button Content="恢复默认参数"
                                Style="{StaticResource GhostButton}"
                                Click="RestoreParams_Click"
                                HorizontalAlignment="Left"
                                Margin="0"
                                ToolTip="恢复全托2.0 默认分档：成本 2/4/8/20/30，重量 0.2/0.5/1 kg"/>
                    </StackPanel>
                </WrapPanel>
                    </StackPanel>
                </Expander>
                <WrapPanel Margin="0,4,0,0">
                    <Button Content="批量计算 (F5)" Style="{StaticResource OrangeButton}" Click="Calc_Click"
                            ToolTip="按全托2.0公式重算全部行"/>
                    <Button Content="添加行" Style="{StaticResource GhostButton}" Click="AddRow_Click"/>
                    <Button Content="删除选中" Style="{StaticResource GhostButton}" Click="Delete_Click"/>
                    <Button Content="清空" Style="{StaticResource GhostButton}" Click="Clear_Click"/>
                    <Button Content="复制SKU和最终价" Background="#3B82F6" Click="CopySkuPrice_Click" Margin="0"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,10"
                Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="速卖通全托管产品详情"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"
                           Margin="0,0,0,6"/>
                <TextBlock Text="维护店小秘编辑链接（如 https://www.dianxiaomi.com/web/smtChoice/edit?id=…）。打开后读取【变种信息】SKU，重量优先按货品条码匹配【货品信息】重量(kg)，该产品没有货品条码时回退用变种自带重量。可改「搜索SKU」再取参考价；回写仍按「页面SKU」匹配供货价。"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left"
                               Text="产品链接"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBox x:Name="ProductUrlBox"
                             VerticalContentAlignment="Center"
                             LostFocus="ProductUrlBox_LostFocus"/>
                </DockPanel>
                <TextBlock Text="打开详情页后「搜索SKU」自动去掉末尾通用后缀，颜色后缀保留（如 4xJ0202-grey-001 → 4xJ0202-grey），因为店小秘商品库里的货号是带颜色的。后缀在表格下方的「SKU 后缀」里维护。"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>
                <WrapPanel>
                    <Button Content="打开速卖通产品详情页"
                            Style="{StaticResource OrangeButton}"
                            Click="OpenProduct_Click"
                            ToolTip="用已导出 Cookie 打开链接，读取变种 SKU，并按货品条码匹配货品重量"/>
                    <Button Content="搜索并定价"
                            Background="#0F766E"
                            Click="SearchAndPrice_Click"
                            ToolTip="按「搜索SKU」调用店小秘商品搜索，只用参考价作为成本；重量仍用货品信息匹配结果"/>
                    <Button Content="回写供货价"
                            Style="{StaticResource SuccessButton}"
                            Click="WriteBack_Click"
                            ToolTip="把最终价写入详情页变种表的供货价，请再在店小秘页面保存"/>
                    <Button Content="检查SKU占用"
                            Style="{StaticResource GhostButton}"
                            Click="CheckOccupancy_Click"
                            ToolTip="按当前店铺查询采集箱、待发布、在线产品，找出同店铺已占用这些 SKU 的产品"/>
                    <Button Content="应用新SKU"
                            Background="#0F766E"
                            Click="ApplySuggestedSkus_Click"
                            ToolTip="把表格中已确认未占用的建议 SKU 写入详情页变种信息"/>
                    <Button Content="恢复原SKU"
                            Style="{StaticResource GhostButton}"
                            Click="RestoreOriginalSkus_Click"
                            ToolTip="把详情页中已替换的 SKU 恢复为原页面 SKU"/>
                </WrapPanel>
                <WrapPanel Margin="0,4,0,0">
                    <TextBlock Text="查重范围"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,0,6,4"/>
                    <ComboBox x:Name="OccupancyScopeCombo"
                              MinWidth="210"
                              Margin="0,0,14,4"
                              VerticalContentAlignment="Center"
                              ToolTip="选择要核对的产品状态范围"
                              SelectionChanged="OccupancyScope_SelectionChanged">
                        <ComboBoxItem Content="全部（采集箱 + 待发布 + 在线）"/>
                        <ComboBoxItem Content="仅在线"/>
                        <ComboBoxItem Content="仅待发布"/>
                        <ComboBoxItem Content="仅采集箱"/>
                    </ComboBox>
                    <TextBlock Text="查重店铺"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,0,6,4"/>
                    <ComboBox x:Name="OccupancyShopCombo"
                              MinWidth="220"
                              Margin="0,0,6,4"
                              VerticalContentAlignment="Center"
                              DisplayMemberPath="Display"
                              ToolTip="默认跟随当前产品所属店铺；也可手动选一个店铺来核对"
                              SelectionChanged="OccupancyShop_SelectionChanged"/>
                    <Button Content="刷新店铺列表"
                            Style="{StaticResource GhostButton}"
                            Padding="8,2"
                            Margin="0,0,0,4"
                            Click="RefreshShops_Click"
                            ToolTip="拉取速卖通全托管下有商品的店铺，供上面下拉选择"/>
                </WrapPanel>
                <Expander Style="{StaticResource SectionExpander}"
                          IsExpanded="False"
                          Margin="0,8,0,0">
                    <Expander.Header>
                        <TextBlock Text="SKU 后缀（产品重复时使用）"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </Expander.Header>
                    <StackPanel Margin="0,6,0,0">
                        <TextBlock Text="中英文逗号均可。「搜索SKU」打开详情页时去掉末尾的通用后缀、保留颜色；查重发现重复时，再按顺序拼接通用后缀生成新 SKU（启用颜色后缀则每段各选一个颜色）。"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6"/>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="通用后缀"
                                       Width="64"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBox x:Name="SuffixBox"
                                     VerticalContentAlignment="Center"
                                     ToolTip="中英文逗号分隔。去掉「搜索SKU」末尾的这一段，并在查重时按顺序拼接出未占用的新 SKU"
                                     LostFocus="SuffixBox_LostFocus"/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left"
                                       Text="颜色后缀"
                                       Width="64"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBox x:Name="ColorSuffixBox"
                                     VerticalContentAlignment="Center"
                                     ToolTip="中英文逗号分隔。查重时启用颜色后缀后，组合 SKU 的每一段各选一个颜色"
                                     LostFocus="ColorSuffixBox_LostFocus"/>
                        </DockPanel>
                    </StackPanel>
                </Expander>
                <Border x:Name="OccupancyPanel"
                        Visibility="Collapsed"
                        Background="#FEF2F2"
                        BorderBrush="#FECACA"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,8"
                        Margin="0,8,0,0">
                    <StackPanel>
                        <Expander x:Name="OccupancyExpander" IsExpanded="True" Foreground="#B91C1C">
                            <Expander.Header>
                                <TextBlock x:Name="OccupancyTitle"
                                           Foreground="#B91C1C"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"/>
                            </Expander.Header>
                            <ScrollViewer x:Name="OccupancyScroll"
                                          MinHeight="330"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Margin="0,6,0,0">
                                <ItemsControl x:Name="OccupancyList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#FECACA" BorderThickness="0,0,0,1" Padding="0,6,0,6">
                                                <StackPanel>
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Sku}"
                                                                   FontWeight="Bold"
                                                                   Foreground="#7F1D1D"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,10,4"
                                                                   ToolTip="{Binding BaseHint}"/>
                                                        <TextBlock Text="建议SKU"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="#7F1D1D"
                                                                   Margin="0,0,6,4"/>
                                                        <TextBox Text="{Binding SuggestedSku, UpdateSourceTrigger=PropertyChanged}"
                                                                 MinWidth="160"
                                                                 Width="220"
                                                                 Margin="0,0,8,4"
                                                                 Padding="6,3"
                                                                 VerticalContentAlignment="Center"
                                                                 ToolTip="可直接修改。这是去掉末尾后缀后，按顺序找到的第一个不再重复的 SKU"
                                                                 TextChanged="SuggestedSku_TextChanged"
                                                                 LostFocus="SuggestedSku_LostFocus"/>
                                                        <TextBlock Text="{Binding SuggestStatus}"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="#9A3412"
                                                                   Margin="0,0,0,4"
                                                                   TextWrapping="Wrap"/>
                                                    </WrapPanel>
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <CheckBox Content="启用颜色后缀"
                                                                  Foreground="#7F1D1D"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,8,4"
                                                                  IsChecked="{Binding UseColorSuffix, Mode=TwoWay}"
                                                                  Checked="UseColorSuffix_Changed"
                                                                  Unchecked="UseColorSuffix_Changed"/>
                                                        <TextBlock Text="（组合 SKU 每一段各选一个颜色，按原顺序拼回）"
                                                                   Foreground="#9A3412"
                                                                   FontSize="11"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,0,4">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding UseColorSuffix}" Value="True"/>
                                                                                <Condition Binding="{Binding HasMultipleParts}" Value="True"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </WrapPanel>
                                                    <ItemsControl ItemsSource="{Binding Parts}">
                                                        <ItemsControl.Style>
                                                            <Style TargetType="ItemsControl">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding UseColorSuffix}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ItemsControl.Style>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <WrapPanel VerticalAlignment="Center" Margin="0,0,0,4">
                                                                    <TextBlock Text="{Binding Label}"
                                                                               Foreground="#7F1D1D"
                                                                               VerticalAlignment="Center"
                                                                               Margin="0,0,6,0"
                                                                               ToolTip="该段基础货号：会与所选颜色、查重后缀拼成这一段"/>
                                                                    <ComboBox ItemsSource="{Binding Owner.ColorOptions}"
                                                                              SelectedItem="{Binding SelectedColor, Mode=TwoWay}"
                                                                              MinWidth="120"
                                                                              Margin="0,0,8,0"
                                                                              ToolTip="为该段选择颜色后缀；各段拼接后按原组合顺序组成新 SKU"
                                                                              SelectionChanged="ColorSuffixCombo_SelectionChanged">
                                                                        <ComboBox.Style>
                                                                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Owner.UseColorSuffix}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </ComboBox.Style>
                                                                    </ComboBox>
                                                                </WrapPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <ItemsControl ItemsSource="{Binding Hits}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Margin="12,2,0,2" TextWrapping="Wrap">
                                                                    <Run Text="{Binding Summary}" Foreground="#7F1D1D"/>
                                                                    <Run Text="  "/>
                                                                    <Hyperlink Click="OccupancyLink_Click"
                                                                               Tag="{Binding EditUrl}"
                                                                               Foreground="#1D4ED8">打开该产品</Hyperlink>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Expander>
                        <Expander x:Name="DetailProbeExpander"
                                  Visibility="Collapsed"
                                  Margin="0,6,0,0"
                                  Foreground="#7F1D1D">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="详情核对失败诊断"
                                               Foreground="#7F1D1D"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                    <Button Content="复制"
                                            Style="{StaticResource GhostButton}"
                                            Padding="6,1"
                                            Margin="8,0,0,0"
                                            Click="CopyDetailProbes_Click"
                                            ToolTip="复制诊断内容，便于排查为什么读不到详情变种"/>
                                </StackPanel>
                            </Expander.Header>
                            <ListBox x:Name="DetailProbeList"
                                     MaxHeight="150"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#7F1D1D"
                                     FontSize="11"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <DataGrid x:Name="PricingGrid"
                      MinHeight="400"
                      Height="400"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserSortColumns="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      CanUserReorderColumns="False"
                      RowHeight="34"
                      AlternatingRowBackground="#FAFBFD"
                      BorderThickness="0"
                      EnableRowVirtualization="True"
                      SelectionUnit="Cell"
                      SelectionMode="Extended"
                      CellEditEnding="PricingGrid_CellEditEnding">
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#D6E8FF"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1B2430"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#D6E8FF"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1B2430"/>
                </DataGrid.Resources>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter VerticalAlignment="Stretch"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#D6E8FF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEditing" Value="True">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Padding" Value="8,8"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="MinHeight" Value="40"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Index}" IsReadOnly="True" Width="44"/>
                    <DataGridTextColumn Header="页面SKU" Binding="{Binding PageSku}" IsReadOnly="True" Width="*"
                                        MinWidth="110"
                                        ElementStyle="{StaticResource ReadSkuCell}"/>
                    <DataGridTextColumn Header="建议SKU" Binding="{Binding SuggestedSku}" IsReadOnly="True" Width="*"
                                        MinWidth="110"
                                        ElementStyle="{StaticResource ReadSkuCell}"/>
                    <DataGridTextColumn Header="搜索SKU" Binding="{Binding Sku, UpdateSourceTrigger=LostFocus}" Width="*"
                                        MinWidth="110"
                                        ElementStyle="{StaticResource InputCell}"
                                        EditingElementStyle="{StaticResource InputEdit}"/>
                    <DataGridTextColumn Header="产品成本"
                                        Binding="{Binding Cost, Converter={StaticResource NullableDouble}, UpdateSourceTrigger=LostFocus}"
                                        Width="88"
                                        ElementStyle="{StaticResource InputCell}"
                                        EditingElementStyle="{StaticResource InputEdit}"/>
                    <DataGridTextColumn Header="重量(g)"
                                        Binding="{Binding Weight, Converter={StaticResource NullableDouble}, UpdateSourceTrigger=LostFocus}"
                                        Width="78"
                                        ElementStyle="{StaticResource InputCell}"
                                        EditingElementStyle="{StaticResource InputEdit}"/>
                    <DataGridTextColumn Header="换算重量(kg)"
                                        Binding="{Binding ConvertedWeight, UpdateSourceTrigger=LostFocus}"
                                        Width="96"
                                        ElementStyle="{StaticResource InputCell}"
                                        EditingElementStyle="{StaticResource InputEdit}"/>
                    <DataGridTextColumn Header="区间" Binding="{Binding Interval}" IsReadOnly="True" Width="78"
                                        ElementStyle="{StaticResource ResultCell}"/>
                    <DataGridTextColumn Header="毛利" Binding="{Binding Margin}" IsReadOnly="True" Width="78"
                                        ElementStyle="{StaticResource ResultCell}"/>
                    <DataGridTextColumn Header="分子1" Binding="{Binding Factor1}" IsReadOnly="True" Width="64"
                                        ElementStyle="{StaticResource ResultCell}"/>
                    <DataGridTextColumn Header="常量" Binding="{Binding Constant}" IsReadOnly="True" Width="64"
                                        ElementStyle="{StaticResource ResultCell}"/>
                    <DataGridTextColumn Header="分子2" Binding="{Binding Factor2}" IsReadOnly="True" Width="64"
                                        ElementStyle="{StaticResource ResultCell}"/>
                    <DataGridTextColumn Header="零售价" Binding="{Binding RetailPrice}" IsReadOnly="True" Width="78"
                                        ElementStyle="{StaticResource ResultCell}"/>
                    <DataGridTextColumn Header="加价" Binding="{Binding Markup}" IsReadOnly="True" Width="64"
                                        ElementStyle="{StaticResource ResultCell}"/>
                    <DataGridTextColumn Header="最终价" Binding="{Binding FinalPrice}" IsReadOnly="True" Width="88"
                                        ElementStyle="{StaticResource KeyResultCell}"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" IsReadOnly="True" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="6,2"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="OK">
                                        <Setter Property="Foreground" Value="{StaticResource OkGreenBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="4"
                   Margin="4,8,4,0"
                   Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap"
                   Text="提示：黄色列为可编辑（搜索SKU、成本、重量、换算重量）· 打开详情页时重量优先按货品条码匹配【货品信息】重量(kg)，无货品条码时用变种自带重量 · 搜索不改重量 · 改克或千克会互相同步 · 最终价写入详情页供货价"/>
    </Grid>
    </ScrollViewer>
</UserControl>
