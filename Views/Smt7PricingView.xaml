<UserControl x:Class="EcommerceWorkbench.Views.Smt7PricingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:EcommerceWorkbench.Converters">
    <UserControl.Resources>
        <conv:NullableDoubleConverter x:Key="NullableDouble"/>
        <Style x:Key="InputCell" TargetType="TextBlock">
            <Setter Property="Background" Value="{StaticResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="6,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="InputEdit" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="SelectionBrush" Value="#BBDEFB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ResultCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
        </Style>
        <Style x:Key="ReadSkuCell" TargetType="TextBlock" BasedOn="{StaticResource ResultCell}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="Padding" Value="6,6"/>
        </Style>
        <Style x:Key="KeyResultCell" TargetType="TextBlock" BasedOn="{StaticResource ResultCell}">
            <Setter Property="Background" Value="{StaticResource KeyResultBgBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="ParamBox" TargetType="TextBox">
            <Setter Property="Width" Value="58"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="ParamHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,6,4"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <StackPanel>
                <TextBlock Text="速卖通7 定价 · 对齐全托2.0"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="打开店小秘速卖通全托管详情页读取【变种信息】SKU；搜索参考价与重量后按全托2.0公式计算，再把最终价回写到供货价"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,10"
                Margin="0,10,0,8">
            <StackPanel>
                <TextBlock Text="公式对齐计算表「全托2.0」：零售价 = ROUND((成本/分子1 + 常量)/分子2, 2)；最终价 = ROUND(零售价 + 重量加价, 2)。搜索重量为克，换算重量 = 克/1000（kg）。修改下方分档后失焦即保存，并按新参数重算。"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>
                <WrapPanel>
                    <Border Background="#FFF3E0" Padding="10,8" Margin="0,0,10,8" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="成本分档（成本上限&lt; 不含本档，最后一档为其余）"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="成本上限&lt;" Style="{StaticResource ParamHeader}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="分子1" Style="{StaticResource ParamHeader}"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="常量" Style="{StaticResource ParamHeader}"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="分子2" Style="{StaticResource ParamHeader}"/>
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="毛利%" Style="{StaticResource ParamHeader}"/>

                                <TextBox x:Name="CostMaxBox1" Grid.Row="1" Grid.Column="0" Style="{StaticResource ParamBox}" Text="2" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostFactor1Box1" Grid.Row="1" Grid.Column="1" Style="{StaticResource ParamBox}" Text="0.50" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostConstBox1" Grid.Row="1" Grid.Column="2" Style="{StaticResource ParamBox}" Text="0.50" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostFactor2Box1" Grid.Row="1" Grid.Column="3" Style="{StaticResource ParamBox}" Text="0.94" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostMarginBox1" Grid.Row="1" Grid.Column="4" Style="{StaticResource ParamBox}" Text="35" LostFocus="Param_LostFocus"/>

                                <TextBox x:Name="CostMaxBox2" Grid.Row="2" Grid.Column="0" Style="{StaticResource ParamBox}" Text="4" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostFactor1Box2" Grid.Row="2" Grid.Column="1" Style="{StaticResource ParamBox}" Text="0.55" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostConstBox2" Grid.Row="2" Grid.Column="2" Style="{StaticResource ParamBox}" Text="0.50" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostFactor2Box2" Grid.Row="2" Grid.Column="3" Style="{StaticResource ParamBox}" Text="0.94" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostMarginBox2" Grid.Row="2" Grid.Column="4" Style="{StaticResource ParamBox}" Text="30" LostFocus="Param_LostFocus"/>

                                <TextBox x:Name="CostMaxBox3" Grid.Row="3" Grid.Column="0" Style="{StaticResource ParamBox}" Text="8" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostFactor1Box3" Grid.Row="3" Grid.Column="1" Style="{StaticResource ParamBox}" Text="0.58" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostConstBox3" Grid.Row="3" Grid.Column="2" Style="{StaticResource ParamBox}" Text="0.50" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostFactor2Box3" Grid.Row="3" Grid.Column="3" Style="{StaticResource ParamBox}" Text="0.94" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostMarginBox3" Grid.Row="3" Grid.Column="4" Style="{StaticResource ParamBox}" Text="25" LostFocus="Param_LostFocus"/>

                                <TextBox x:Name="CostMaxBox4" Grid.Row="4" Grid.Column="0" Style="{StaticResource ParamBox}" Text="20" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostFactor1Box4" Grid.Row="4" Grid.Column="1" Style="{StaticResource ParamBox}" Text="0.60" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostConstBox4" Grid.Row="4" Grid.Column="2" Style="{StaticResource ParamBox}" Text="0.50" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostFactor2Box4" Grid.Row="4" Grid.Column="3" Style="{StaticResource ParamBox}" Text="0.94" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostMarginBox4" Grid.Row="4" Grid.Column="4" Style="{StaticResource ParamBox}" Text="25" LostFocus="Param_LostFocus"/>

                                <TextBox x:Name="CostMaxBox5" Grid.Row="5" Grid.Column="0" Style="{StaticResource ParamBox}" Text="30" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostFactor1Box5" Grid.Row="5" Grid.Column="1" Style="{StaticResource ParamBox}" Text="0.62" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostConstBox5" Grid.Row="5" Grid.Column="2" Style="{StaticResource ParamBox}" Text="0.50" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostFactor2Box5" Grid.Row="5" Grid.Column="3" Style="{StaticResource ParamBox}" Text="0.94" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostMarginBox5" Grid.Row="5" Grid.Column="4" Style="{StaticResource ParamBox}" Text="27" LostFocus="Param_LostFocus"/>

                                <TextBox Grid.Row="6" Grid.Column="0" Style="{StaticResource ParamBox}" Text="其余" IsReadOnly="True"
                                         HorizontalContentAlignment="Center" Background="#EEF2F6"/>
                                <TextBox x:Name="CostFactor1Box6" Grid.Row="6" Grid.Column="1" Style="{StaticResource ParamBox}" Text="0.65" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostConstBox6" Grid.Row="6" Grid.Column="2" Style="{StaticResource ParamBox}" Text="1.00" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostFactor2Box6" Grid.Row="6" Grid.Column="3" Style="{StaticResource ParamBox}" Text="0.94" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="CostMarginBox6" Grid.Row="6" Grid.Column="4" Style="{StaticResource ParamBox}" Text="25" LostFocus="Param_LostFocus"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Background="#F8FAFC" Padding="10,8" Margin="0,0,10,8" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="重量加价（换算重量 kg，上限不含本档）"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="换算重量&lt;(kg)" Style="{StaticResource ParamHeader}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="加价" Style="{StaticResource ParamHeader}"/>

                                <TextBox x:Name="WeightMaxBox1" Grid.Row="1" Grid.Column="0" Style="{StaticResource ParamBox}" Width="88" Text="0.2" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="WeightMarkupBox1" Grid.Row="1" Grid.Column="1" Style="{StaticResource ParamBox}" Text="0" LostFocus="Param_LostFocus"/>

                                <TextBox x:Name="WeightMaxBox2" Grid.Row="2" Grid.Column="0" Style="{StaticResource ParamBox}" Width="88" Text="0.5" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="WeightMarkupBox2" Grid.Row="2" Grid.Column="1" Style="{StaticResource ParamBox}" Text="0.50" LostFocus="Param_LostFocus"/>

                                <TextBox x:Name="WeightMaxBox3" Grid.Row="3" Grid.Column="0" Style="{StaticResource ParamBox}" Width="88" Text="1" LostFocus="Param_LostFocus"/>
                                <TextBox x:Name="WeightMarkupBox3" Grid.Row="3" Grid.Column="1" Style="{StaticResource ParamBox}" Text="1.00" LostFocus="Param_LostFocus"/>

                                <TextBox Grid.Row="4" Grid.Column="0" Style="{StaticResource ParamBox}" Width="88" Text="其余" IsReadOnly="True"
                                         HorizontalContentAlignment="Center" Background="#EEF2F6"/>
                                <TextBox x:Name="WeightMarkupBox4" Grid.Row="4" Grid.Column="1" Style="{StaticResource ParamBox}" Text="2.00" LostFocus="Param_LostFocus"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="8,8,0,8">
                        <CheckBox x:Name="AutoCalcCheck"
                                  Content="参数变更后自动计算"
                                  IsChecked="True"
                                  Margin="0,0,0,8"/>
                        <Button Content="恢复默认参数"
                                Style="{StaticResource GhostButton}"
                                Click="RestoreParams_Click"
                                HorizontalAlignment="Left"
                                Margin="0"
                                ToolTip="恢复全托2.0 默认分档：成本 2/4/8/20/30，重量 0.2/0.5/1 kg"/>
                    </StackPanel>
                </WrapPanel>
                <WrapPanel Margin="0,4,0,0">
                    <Button Content="批量计算 (F5)" Style="{StaticResource OrangeButton}" Click="Calc_Click"
                            ToolTip="按全托2.0公式重算全部行"/>
                    <Button Content="添加行" Style="{StaticResource GhostButton}" Click="AddRow_Click"/>
                    <Button Content="删除选中" Style="{StaticResource GhostButton}" Click="Delete_Click"/>
                    <Button Content="清空" Style="{StaticResource GhostButton}" Click="Clear_Click"/>
                    <Button Content="复制SKU和最终价" Background="#3B82F6" Click="CopySkuPrice_Click" Margin="0"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,10"
                Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="速卖通全托管产品详情"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"
                           Margin="0,0,0,6"/>
                <TextBlock Text="维护店小秘编辑链接（如 https://www.dianxiaomi.com/web/smtChoice/edit?id=…）。打开后读取【变种信息】SKU 编码；可改「搜索SKU」再定价，回写时仍按「页面SKU」匹配供货价。"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left"
                               Text="产品链接"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBox x:Name="ProductUrlBox"
                             VerticalContentAlignment="Center"
                             LostFocus="ProductUrlBox_LostFocus"/>
                </DockPanel>
                <WrapPanel>
                    <Button Content="打开速卖通产品详情页"
                            Style="{StaticResource OrangeButton}"
                            Click="OpenProduct_Click"
                            ToolTip="用已导出 Cookie 打开链接，并读取变种 SKU 到下方表格"/>
                    <Button Content="搜索并定价"
                            Background="#0F766E"
                            Click="SearchAndPrice_Click"
                            ToolTip="按「搜索SKU」调用店小秘商品搜索，再用参考价和重量按全托2.0计算"/>
                    <Button Content="回写供货价"
                            Style="{StaticResource SuccessButton}"
                            Click="WriteBack_Click"
                            Margin="0"
                            ToolTip="把最终价写入详情页变种表的供货价，请再在店小秘页面保存"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <DataGrid x:Name="PricingGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserSortColumns="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      CanUserReorderColumns="False"
                      RowHeight="34"
                      AlternatingRowBackground="#FAFBFD"
                      BorderThickness="0"
                      EnableRowVirtualization="True"
                      SelectionUnit="Cell"
                      SelectionMode="Extended"
                      CellEditEnding="PricingGrid_CellEditEnding">
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#D6E8FF"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1B2430"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#D6E8FF"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1B2430"/>
                </DataGrid.Resources>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter VerticalAlignment="Stretch"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#D6E8FF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEditing" Value="True">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Padding" Value="8,8"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="MinHeight" Value="40"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Index}" IsReadOnly="True" Width="44"/>
                    <DataGridTextColumn Header="页面SKU" Binding="{Binding PageSku}" IsReadOnly="True" Width="*"
                                        MinWidth="110"
                                        ElementStyle="{StaticResource ReadSkuCell}"/>
                    <DataGridTextColumn Header="搜索SKU" Binding="{Binding Sku, UpdateSourceTrigger=LostFocus}" Width="*"
                                        MinWidth="110"
                                        ElementStyle="{StaticResource InputCell}"
                                        EditingElementStyle="{StaticResource InputEdit}"/>
                    <DataGridTextColumn Header="产品成本"
                                        Binding="{Binding Cost, Converter={StaticResource NullableDouble}, UpdateSourceTrigger=LostFocus}"
                                        Width="88"
                                        ElementStyle="{StaticResource InputCell}"
                                        EditingElementStyle="{StaticResource InputEdit}"/>
                    <DataGridTextColumn Header="重量(g)"
                                        Binding="{Binding Weight, Converter={StaticResource NullableDouble}, UpdateSourceTrigger=LostFocus}"
                                        Width="78"
                                        ElementStyle="{StaticResource InputCell}"
                                        EditingElementStyle="{StaticResource InputEdit}"/>
                    <DataGridTextColumn Header="换算重量(kg)"
                                        Binding="{Binding ConvertedWeight, UpdateSourceTrigger=LostFocus}"
                                        Width="96"
                                        ElementStyle="{StaticResource InputCell}"
                                        EditingElementStyle="{StaticResource InputEdit}"/>
                    <DataGridTextColumn Header="区间" Binding="{Binding Interval}" IsReadOnly="True" Width="78"
                                        ElementStyle="{StaticResource ResultCell}"/>
                    <DataGridTextColumn Header="毛利" Binding="{Binding Margin}" IsReadOnly="True" Width="78"
                                        ElementStyle="{StaticResource ResultCell}"/>
                    <DataGridTextColumn Header="分子1" Binding="{Binding Factor1}" IsReadOnly="True" Width="64"
                                        ElementStyle="{StaticResource ResultCell}"/>
                    <DataGridTextColumn Header="常量" Binding="{Binding Constant}" IsReadOnly="True" Width="64"
                                        ElementStyle="{StaticResource ResultCell}"/>
                    <DataGridTextColumn Header="分子2" Binding="{Binding Factor2}" IsReadOnly="True" Width="64"
                                        ElementStyle="{StaticResource ResultCell}"/>
                    <DataGridTextColumn Header="零售价" Binding="{Binding RetailPrice}" IsReadOnly="True" Width="78"
                                        ElementStyle="{StaticResource ResultCell}"/>
                    <DataGridTextColumn Header="加价" Binding="{Binding Markup}" IsReadOnly="True" Width="64"
                                        ElementStyle="{StaticResource ResultCell}"/>
                    <DataGridTextColumn Header="最终价" Binding="{Binding FinalPrice}" IsReadOnly="True" Width="88"
                                        ElementStyle="{StaticResource KeyResultCell}"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" IsReadOnly="True" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="6,2"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="OK">
                                        <Setter Property="Foreground" Value="{StaticResource OkGreenBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="4"
                   Margin="4,8,4,0"
                   Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap"
                   Text="提示：黄色列为可编辑（搜索SKU、成本、重量、换算重量）· 改克或千克会互相同步（kg = g/1000）· 上方分档可改并自动保存 · 最终价写入详情页供货价 · 请在店小秘页面确认后保存/发布"/>
    </Grid>
</UserControl>
