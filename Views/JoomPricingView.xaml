<UserControl x:Class="EcommerceWorkbench.Views.JoomPricingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:EcommerceWorkbench.Converters">
    <UserControl.Resources>
        <conv:NullableDoubleConverter x:Key="NullableDouble"/>
        <Style x:Key="InputCell" TargetType="TextBlock">
            <Setter Property="Background" Value="{StaticResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="6,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="InputEdit" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="SelectionBrush" Value="#BBDEFB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ResultCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
        </Style>
        <Style x:Key="ReadSkuCell" TargetType="TextBlock" BasedOn="{StaticResource ResultCell}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="Padding" Value="6,6"/>
        </Style>
        <Style x:Key="KeyResultCell" TargetType="TextBlock" BasedOn="{StaticResource ResultCell}">
            <Setter Property="Background" Value="{StaticResource KeyResultBgBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="ParamBox" TargetType="TextBox">
            <Setter Property="Width" Value="72"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style x:Key="SectionExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Content="{TemplateBinding Header}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          HorizontalContentAlignment="Stretch"
                                          Cursor="Hand"
                                          Focusable="False"
                                          Padding="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="0,1">
                                            <DockPanel>
                                                <TextBlock x:Name="Chevron"
                                                           DockPanel.Dock="Left"
                                                           Text="▸"
                                                           Width="16"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Expander}}"/>
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                  VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="Text" Value="▾"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Margin="0,8,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="PageScroll"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PreviewMouseWheel="PageScroll_PreviewMouseWheel">
    <Grid Margin="14,10,14,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="JOOM 批量定价"
                       Style="{StaticResource PageTitleStyle}"
                       VerticalAlignment="Center"/>
            <TextBlock Text="读取变种 SKU → 搜索定价 → 回写 MSRP/价格"
                       Style="{StaticResource PageDescriptionStyle}"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <Border Grid.Row="1"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,8"
                Margin="0,0,0,8">
            <StackPanel>
                <Expander Style="{StaticResource SectionExpander}" IsExpanded="False">
                    <Expander.Header>
                        <TextBlock Text="分档参数 · 默认对齐 JOOM1.0（佣金 15%，毛利率随成本递减）"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </Expander.Header>
                    <WrapPanel>
                        <Border Background="{StaticResource AccentSoftBrush}" Padding="12,10" Margin="0,0,14,8" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="汇率 CNY→USD" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                                <TextBox x:Name="RateBox" Width="110" Text="6.3"
                                         HorizontalContentAlignment="Right"
                                         LostFocus="Param_LostFocus"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceAltBrush}" Padding="12,10" Margin="0,0,14,8" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="0-10 元" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="平台佣金 %" Style="{StaticResource ParamLabel}"/>
                                        <TextBox x:Name="LowCommissionBox" Style="{StaticResource ParamBox}" Text="15" LostFocus="Param_LostFocus"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="毛利率 %" Style="{StaticResource ParamLabel}"/>
                                        <TextBox x:Name="LowMarginBox" Style="{StaticResource ParamBox}" Text="50" LostFocus="Param_LostFocus"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceAltBrush}" Padding="12,10" Margin="0,0,14,8" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="10-20 元" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="平台佣金 %" Style="{StaticResource ParamLabel}"/>
                                        <TextBox x:Name="MidCommissionBox" Style="{StaticResource ParamBox}" Text="15" LostFocus="Param_LostFocus"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="毛利率 %" Style="{StaticResource ParamLabel}"/>
                                        <TextBox x:Name="MidMarginBox" Style="{StaticResource ParamBox}" Text="45" LostFocus="Param_LostFocus"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceAltBrush}" Padding="12,10" Margin="0,0,14,8" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="20 元以上" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="平台佣金 %" Style="{StaticResource ParamLabel}"/>
                                        <TextBox x:Name="HighCommissionBox" Style="{StaticResource ParamBox}" Text="15" LostFocus="Param_LostFocus"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="毛利率 %" Style="{StaticResource ParamLabel}"/>
                                        <TextBox x:Name="HighMarginBox" Style="{StaticResource ParamBox}" Text="40" LostFocus="Param_LostFocus"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <CheckBox x:Name="AutoCalcCheck"
                                  Content="参数变更后自动计算"
                                  IsChecked="True"
                                  VerticalAlignment="Center"
                                  Margin="8,22,0,8"/>
                    </WrapPanel>
                </Expander>
                <WrapPanel Margin="0,6,0,0">
                    <Button Content="批量计算 (F5)" Style="{StaticResource OrangeButton}" Click="Calc_Click"
                            ToolTip="按当前分档参数重算全部行的售价与利润"/>
                    <Button Content="添加行" Style="{StaticResource GhostButton}" Click="AddRow_Click"/>
                    <Button Content="删除选中" Style="{StaticResource GhostButton}" Click="Delete_Click"/>
                    <Button Content="清空" Style="{StaticResource GhostButton}" Click="Clear_Click"/>
                    <Button Content="复制SKU和售价" Background="#3B82F6" Click="CopySkuPrice_Click" Margin="0"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,8"
                Margin="0,0,0,8">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Left"
                               Text="产品链接"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBox x:Name="ProductUrlBox"
                             VerticalContentAlignment="Center"
                             ToolTip="店小秘 JOOM 编辑链接，如 https://www.dianxiaomi.com/web/joomProduct/edit?id=…"
                             LostFocus="ProductUrlBox_LostFocus"/>
                </DockPanel>
                <WrapPanel>
                    <Button Content="打开JOOM产品详情页"
                            Style="{StaticResource OrangeButton}"
                            Click="OpenProduct_Click"
                            ToolTip="用已导出 Cookie 打开链接，并读取变种 SKU 到下方表格"/>
                    <Button Content="搜索并定价"
                            Background="#0F766E"
                            Click="SearchAndPrice_Click"
                            ToolTip="按「搜索SKU」调用店小秘商品搜索，再用参考价计算 JOOM 售价"/>
                    <Button Content="回写MSRP和价格"
                            Style="{StaticResource SuccessButton}"
                            Click="WriteBack_Click"
                            ToolTip="把售价写入详情页变种表的 MSRP 和价格列，请再在店小秘页面保存"/>
                    <Button Content="检查SKU占用"
                            Style="{StaticResource GhostButton}"
                            Click="CheckOccupancy_Click"
                            Margin="0"
                            ToolTip="用当前「页面SKU」查询采集箱、待发布、在线产品。若产品重复，按后缀生成可修改的新 SKU"/>
                </WrapPanel>
                <Expander Style="{StaticResource SectionExpander}"
                          IsExpanded="False"
                          Margin="0,8,0,0">
                    <Expander.Header>
                        <TextBlock Text="SKU 后缀（产品重复时使用）"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </Expander.Header>
                    <StackPanel Margin="0,6,0,0">
                        <TextBlock Text="中英文逗号均可。重复时去掉原 SKU 第一个「-」及后缀，再按顺序拼接。启用颜色后如 E0032-red-1。"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6"/>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="通用后缀"
                                       Width="64"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBox x:Name="GeneralSuffixBox"
                                     VerticalContentAlignment="Center"
                                     ToolTip="可修改。中文逗号或英文逗号分隔，按从左到右的顺序尝试"
                                     LostFocus="SuffixBox_LostFocus"/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left"
                                       Text="颜色后缀"
                                       Width="64"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBox x:Name="ColorSuffixBox"
                                     VerticalContentAlignment="Center"
                                     ToolTip="可修改。启用颜色后缀时先拼接这里的颜色，再拼接通用后缀"
                                     LostFocus="SuffixBox_LostFocus"/>
                        </DockPanel>
                    </StackPanel>
                </Expander>
                <Border x:Name="OccupancyPanel"
                        Visibility="Collapsed"
                        Background="#FEF2F2"
                        BorderBrush="#FECACA"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,8"
                        Margin="0,8,0,0">
                    <Expander x:Name="OccupancyExpander"
                              Style="{StaticResource SectionExpander}"
                              IsExpanded="True"
                              Foreground="#B91C1C">
                        <Expander.Header>
                            <TextBlock x:Name="OccupancyTitle"
                                       Foreground="#B91C1C"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"/>
                        </Expander.Header>
                        <ScrollViewer x:Name="OccupancyScroll"
                                      MinHeight="330"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Margin="0,6,0,0">
                            <ItemsControl x:Name="OccupancyList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#FECACA" BorderThickness="0,0,0,1" Padding="0,6,0,6">
                                            <StackPanel>
                                                <WrapPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Sku}"
                                                               FontWeight="Bold"
                                                               Foreground="#7F1D1D"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,10,4"
                                                               ToolTip="{Binding BaseHint}"/>
                                                    <TextBlock Text="建议SKU"
                                                               VerticalAlignment="Center"
                                                               Foreground="#7F1D1D"
                                                               Margin="0,0,6,4"/>
                                                    <TextBox Text="{Binding SuggestedSku, UpdateSourceTrigger=PropertyChanged}"
                                                             MinWidth="160"
                                                             Width="220"
                                                             Margin="0,0,8,4"
                                                             Padding="6,3"
                                                             VerticalContentAlignment="Center"
                                                             ToolTip="可直接修改。这是去掉原后缀后，按顺序找到的第一个不再重复的 SKU"
                                                             TextChanged="SuggestedSku_TextChanged"
                                                             LostFocus="SuggestedSku_LostFocus"/>
                                                    <TextBlock Text="{Binding SuggestStatus}"
                                                               VerticalAlignment="Center"
                                                               Foreground="#9A3412"
                                                               Margin="0,0,0,4"
                                                               TextWrapping="Wrap"/>
                                                </WrapPanel>
                                                <WrapPanel VerticalAlignment="Center">
                                                    <CheckBox Content="启用颜色后缀"
                                                              Foreground="#7F1D1D"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,8,4"
                                                              Checked="UseColorSuffix_Changed"
                                                              Unchecked="UseColorSuffix_Changed"/>
                                                    <ComboBox ItemsSource="{Binding ColorOptions}"
                                                              SelectedItem="{Binding SelectedColor, Mode=TwoWay}"
                                                              MinWidth="120"
                                                              Margin="0,0,0,4"
                                                              ToolTip="选择后按「基础SKU + 颜色后缀 + 通用后缀」查找，例如 E0032-red-1"
                                                              SelectionChanged="ColorSuffixCombo_SelectionChanged">
                                                        <ComboBox.Style>
                                                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding UseColorSuffix}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ComboBox.Style>
                                                    </ComboBox>
                                                </WrapPanel>
                                                <ItemsControl ItemsSource="{Binding Hits}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Margin="12,2,0,2" TextWrapping="Wrap">
                                                                <Run Text="{Binding Summary}" Foreground="#7F1D1D"/>
                                                                <Run Text="  "/>
                                                                <Hyperlink Click="OccupancyLink_Click"
                                                                           Tag="{Binding EditUrl}"
                                                                           Foreground="#1D4ED8">打开该产品</Hyperlink>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Expander>
                </Border>
            </StackPanel>
        </Border>

        <Border x:Name="GridHost"
                Grid.Row="3"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <DataGrid x:Name="PricingGrid"
                      MinHeight="400"
                      Height="400"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserSortColumns="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      CanUserReorderColumns="False"
                      RowHeight="34"
                      AlternatingRowBackground="#FAFBFD"
                      BorderThickness="0"
                      EnableRowVirtualization="True"
                      SelectionUnit="Cell"
                      SelectionMode="Extended"
                      CellEditEnding="PricingGrid_CellEditEnding">
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#D6E8FF"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1B2430"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#D6E8FF"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1B2430"/>
                </DataGrid.Resources>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter VerticalAlignment="Stretch"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#D6E8FF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEditing" Value="True">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Padding" Value="8,8"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="MinHeight" Value="40"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Index}" IsReadOnly="True" Width="44"/>
                    <DataGridTextColumn Header="页面SKU" Binding="{Binding PageSku}" IsReadOnly="True" Width="*"
                                        MinWidth="120"
                                        ElementStyle="{StaticResource ReadSkuCell}"/>
                    <DataGridTextColumn Header="搜索SKU" Binding="{Binding Sku, UpdateSourceTrigger=LostFocus}" Width="*"
                                        MinWidth="120"
                                        ElementStyle="{StaticResource InputCell}"
                                        EditingElementStyle="{StaticResource InputEdit}"/>
                    <DataGridTextColumn Header="产品成本（人民币）"
                                        Binding="{Binding Cost, Converter={StaticResource NullableDouble}, UpdateSourceTrigger=LostFocus}"
                                        Width="130"
                                        ElementStyle="{StaticResource InputCell}"
                                        EditingElementStyle="{StaticResource InputEdit}"/>
                    <DataGridTextColumn Header="重量" Binding="{Binding Weight, Converter={StaticResource NullableDouble}}"
                                        IsReadOnly="True" Width="80"
                                        ElementStyle="{StaticResource ResultCell}"/>
                    <DataGridTextColumn Header="区间" Binding="{Binding Interval}" IsReadOnly="True" Width="110"
                                        ElementStyle="{StaticResource ResultCell}"/>
                    <DataGridTextColumn Header="平台佣金" Binding="{Binding Commission}" IsReadOnly="True" Width="90"
                                        ElementStyle="{StaticResource ResultCell}"/>
                    <DataGridTextColumn Header="毛利率" Binding="{Binding Margin}" IsReadOnly="True" Width="90"
                                        ElementStyle="{StaticResource ResultCell}"/>
                    <DataGridTextColumn Header="售价 USD" Binding="{Binding PriceUsd}" IsReadOnly="True" Width="110"
                                        ElementStyle="{StaticResource KeyResultCell}"/>
                    <DataGridTextColumn Header="利润额（人民币）" Binding="{Binding ProfitCny}" IsReadOnly="True" Width="140"
                                        ElementStyle="{StaticResource KeyResultCell}"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" IsReadOnly="True" Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="6,2"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="OK">
                                        <Setter Property="Foreground" Value="{StaticResource OkGreenBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock x:Name="FooterHint"
                   Grid.Row="4"
                   Margin="4,8,4,0"
                   Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap"
                   Text="提示：黄色列为可编辑（搜索SKU、成本）· 页面SKU 与搜索SKU 一对一 · 售价同时写入详情页 MSRP 和价格 · 售价 = 成本/汇率/(1-佣金-毛利率)"/>
    </Grid>
    </ScrollViewer>
</UserControl>
