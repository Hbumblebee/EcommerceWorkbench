<UserControl x:Class="EcommerceWorkbench.Views.JoomPricingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:EcommerceWorkbench.Converters">
    <UserControl.Resources>
        <conv:NullableDoubleConverter x:Key="NullableDouble"/>
        <Style x:Key="InputCell" TargetType="TextBlock">
            <Setter Property="Background" Value="{StaticResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="6,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="InputEdit" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="SelectionBrush" Value="#BBDEFB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ResultCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
        </Style>
        <Style x:Key="ReadSkuCell" TargetType="TextBlock" BasedOn="{StaticResource ResultCell}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="Padding" Value="6,6"/>
        </Style>
        <Style x:Key="KeyResultCell" TargetType="TextBlock" BasedOn="{StaticResource ResultCell}">
            <Setter Property="Background" Value="{StaticResource KeyResultBgBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="ParamBox" TargetType="TextBox">
            <Setter Property="Width" Value="72"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <StackPanel>
                <TextBlock Text="JOOM 定价 · 按成本区间反推售价"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="可打开店小秘 JOOM 产品详情页读取变种 SKU；编辑搜索 SKU 后查询参考价并计算售价，再回写到页面的 MSRP 与价格"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,10"
                Margin="0,10,0,8">
            <StackPanel>
                <TextBlock Text="分档参数 · 默认值对齐 JOOM1.0（佣金三档均为 15%，毛利率随成本升高递减）"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,0,0,8"/>
                <WrapPanel>
                    <Border Background="#FFF3E0" Padding="10,8" Margin="0,0,14,8" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="汇率 CNY→USD" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                            <TextBox x:Name="RateBox" Width="110" Text="6.3"
                                     HorizontalContentAlignment="Right"
                                     LostFocus="Param_LostFocus"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#F8FAFC" Padding="10,8" Margin="0,0,14,8" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="0-10 元" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="平台佣金 %" Style="{StaticResource ParamLabel}"/>
                                    <TextBox x:Name="LowCommissionBox" Style="{StaticResource ParamBox}" Text="15" LostFocus="Param_LostFocus"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="毛利率 %" Style="{StaticResource ParamLabel}"/>
                                    <TextBox x:Name="LowMarginBox" Style="{StaticResource ParamBox}" Text="50" LostFocus="Param_LostFocus"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="#F8FAFC" Padding="10,8" Margin="0,0,14,8" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="10-20 元" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="平台佣金 %" Style="{StaticResource ParamLabel}"/>
                                    <TextBox x:Name="MidCommissionBox" Style="{StaticResource ParamBox}" Text="15" LostFocus="Param_LostFocus"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="毛利率 %" Style="{StaticResource ParamLabel}"/>
                                    <TextBox x:Name="MidMarginBox" Style="{StaticResource ParamBox}" Text="45" LostFocus="Param_LostFocus"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="#F8FAFC" Padding="10,8" Margin="0,0,14,8" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="20 元以上" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="平台佣金 %" Style="{StaticResource ParamLabel}"/>
                                    <TextBox x:Name="HighCommissionBox" Style="{StaticResource ParamBox}" Text="15" LostFocus="Param_LostFocus"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="毛利率 %" Style="{StaticResource ParamLabel}"/>
                                    <TextBox x:Name="HighMarginBox" Style="{StaticResource ParamBox}" Text="40" LostFocus="Param_LostFocus"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <CheckBox x:Name="AutoCalcCheck"
                              Content="参数变更后自动计算"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Margin="8,22,0,8"/>
                </WrapPanel>
                <WrapPanel Margin="0,4,0,0">
                    <Button Content="批量计算 (F5)" Style="{StaticResource OrangeButton}" Click="Calc_Click"
                            ToolTip="按当前分档参数重算全部行的售价与利润"/>
                    <Button Content="添加行" Style="{StaticResource GhostButton}" Click="AddRow_Click"/>
                    <Button Content="删除选中" Style="{StaticResource GhostButton}" Click="Delete_Click"/>
                    <Button Content="清空" Style="{StaticResource GhostButton}" Click="Clear_Click"/>
                    <Button Content="复制SKU和售价" Background="#3B82F6" Click="CopySkuPrice_Click" Margin="0"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,10"
                Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="JOOM 产品详情"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"
                           Margin="0,0,0,6"/>
                <TextBlock Text="维护店小秘编辑链接（如 https://www.dianxiaomi.com/web/joomProduct/edit?id=…）。打开后读取【变种信息】唯一 SKU；可改「搜索SKU」再定价，回写时仍按「页面SKU」一对一匹配。"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left"
                               Text="产品链接"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBox x:Name="ProductUrlBox"
                             VerticalContentAlignment="Center"
                             LostFocus="ProductUrlBox_LostFocus"/>
                </DockPanel>
                <WrapPanel>
                    <Button Content="打开JOOM产品详情页"
                            Style="{StaticResource OrangeButton}"
                            Click="OpenProduct_Click"
                            ToolTip="用已导出 Cookie 打开链接，并读取变种 SKU 到下方表格"/>
                    <Button Content="搜索并定价"
                            Background="#0F766E"
                            Click="SearchAndPrice_Click"
                            ToolTip="按「搜索SKU」调用店小秘商品搜索，再用参考价计算 JOOM 售价"/>
                    <Button Content="回写MSRP和价格"
                            Style="{StaticResource SuccessButton}"
                            Click="WriteBack_Click"
                            Margin="0"
                            ToolTip="把售价写入详情页变种表的 MSRP 和价格列，请再在店小秘页面保存"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <DataGrid x:Name="PricingGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserSortColumns="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      CanUserReorderColumns="False"
                      RowHeight="34"
                      AlternatingRowBackground="#FAFBFD"
                      BorderThickness="0"
                      EnableRowVirtualization="True"
                      SelectionUnit="Cell"
                      SelectionMode="Extended"
                      CellEditEnding="PricingGrid_CellEditEnding">
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#D6E8FF"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1B2430"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#D6E8FF"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1B2430"/>
                </DataGrid.Resources>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter VerticalAlignment="Stretch"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#D6E8FF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEditing" Value="True">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Padding" Value="8,8"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="MinHeight" Value="40"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Index}" IsReadOnly="True" Width="44"/>
                    <DataGridTextColumn Header="页面SKU" Binding="{Binding PageSku}" IsReadOnly="True" Width="*"
                                        MinWidth="120"
                                        ElementStyle="{StaticResource ReadSkuCell}"/>
                    <DataGridTextColumn Header="搜索SKU" Binding="{Binding Sku, UpdateSourceTrigger=LostFocus}" Width="*"
                                        MinWidth="120"
                                        ElementStyle="{StaticResource InputCell}"
                                        EditingElementStyle="{StaticResource InputEdit}"/>
                    <DataGridTextColumn Header="产品成本（人民币）"
                                        Binding="{Binding Cost, Converter={StaticResource NullableDouble}, UpdateSourceTrigger=LostFocus}"
                                        Width="130"
                                        ElementStyle="{StaticResource InputCell}"
                                        EditingElementStyle="{StaticResource InputEdit}"/>
                    <DataGridTextColumn Header="重量" Binding="{Binding Weight, Converter={StaticResource NullableDouble}}"
                                        IsReadOnly="True" Width="80"
                                        ElementStyle="{StaticResource ResultCell}"/>
                    <DataGridTextColumn Header="区间" Binding="{Binding Interval}" IsReadOnly="True" Width="110"
                                        ElementStyle="{StaticResource ResultCell}"/>
                    <DataGridTextColumn Header="平台佣金" Binding="{Binding Commission}" IsReadOnly="True" Width="90"
                                        ElementStyle="{StaticResource ResultCell}"/>
                    <DataGridTextColumn Header="毛利率" Binding="{Binding Margin}" IsReadOnly="True" Width="90"
                                        ElementStyle="{StaticResource ResultCell}"/>
                    <DataGridTextColumn Header="售价 USD" Binding="{Binding PriceUsd}" IsReadOnly="True" Width="110"
                                        ElementStyle="{StaticResource KeyResultCell}"/>
                    <DataGridTextColumn Header="利润额（人民币）" Binding="{Binding ProfitCny}" IsReadOnly="True" Width="140"
                                        ElementStyle="{StaticResource KeyResultCell}"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" IsReadOnly="True" Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="6,2"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="OK">
                                        <Setter Property="Foreground" Value="{StaticResource OkGreenBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="4"
                   Margin="4,8,4,0"
                   Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap"
                   Text="提示：黄色列为可编辑（搜索SKU、成本）· 页面SKU 与搜索SKU 一对一 · 售价同时写入详情页 MSRP 和价格 · 售价 = 成本/汇率/(1-佣金-毛利率)"/>
    </Grid>
</UserControl>
