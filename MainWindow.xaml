<Window x:Class="EcommerceWorkbench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EcommerceWorkbench.Views"
        Title="电商定价工作台"
        Icon="Assets/app.ico"
        Height="900"
        Width="1480"
        MinHeight="720"
        MinWidth="1180"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="TabRadio" TargetType="RadioButton">
            <Setter Property="MinWidth" Value="116"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="15,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource GhostBgBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#BFDBFE"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="40"
                        Height="40"
                        CornerRadius="10"
                        Background="{StaticResource BrandOrangeBrush}"
                        Margin="0,0,12,0">
                    <TextBlock Text="价"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="电商定价工作台"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="店小秘商品搜索、跨平台定价与回写"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Border Grid.Column="2"
                        Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="4">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabSearch"
                                     Style="{StaticResource TabRadio}"
                                     Content="商品搜索"
                                     IsChecked="True"
                                     Checked="TabSearch_Checked"/>
                        <RadioButton x:Name="TabPricing"
                                     Style="{StaticResource TabRadio}"
                                     Content="Shopee 定价"
                                     Checked="TabPricing_Checked"/>
                        <RadioButton x:Name="TabJoom"
                                     Style="{StaticResource TabRadio}"
                                     Content="JOOM"
                                     Checked="TabJoom_Checked"/>
                        <RadioButton x:Name="TabSmt7"
                                     Style="{StaticResource TabRadio}"
                                     Content="速卖通7"
                                     Checked="TabSmt7_Checked"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="16,14,16,10"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True"
                Effect="{StaticResource CardShadow}">
            <Grid x:Name="ContentHost">
                <views:DianxiaomiSearchView x:Name="SearchView"/>
                <views:ShopeePricingView x:Name="PricingView" Visibility="Collapsed"/>
                <views:JoomPricingView x:Name="JoomView" Visibility="Collapsed"/>
                <views:Smt7PricingView x:Name="Smt7View" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse Width="7"
                             Height="7"
                             Fill="{StaticResource OkGreenBrush}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Text="就绪：请先在「店小秘搜索」登录并导出 Cookie。"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <TextBlock x:Name="CountText"
                           Grid.Column="1"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="18,0"
                           Text="有效 0 行 · 已算 0 行"/>
                <Border Grid.Column="2"
                        Background="{StaticResource GhostBgBrush}"
                        CornerRadius="6"
                        Padding="9,4">
                    <TextBlock x:Name="ShortcutHint"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11.5"
                               Text="F5 计算 | Ctrl+E 导出"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
