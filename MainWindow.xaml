<Window x:Class="EcommerceWorkbench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EcommerceWorkbench.Views"
        Title="店小秘 × Shopee 定价工作台"
        Height="900"
        Width="1480"
        MinHeight="720"
        MinWidth="1180"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="TabRadio" TargetType="RadioButton">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrandOrangeBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,10"
                Margin="0,0,0,10">
            <DockPanel>
                <Border Width="4" Background="{StaticResource BrandOrangeBrush}" CornerRadius="2" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="店小秘 × Shopee 定价工作台"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="搜索店小秘商品后一键导入 Shopee 定价或 JOOM 计算"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6,6,0,0"
                Padding="8,0,8,0">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabSearch"
                             Style="{StaticResource TabRadio}"
                             Content="店小秘搜索"
                             IsChecked="True"
                             Checked="TabSearch_Checked"/>
                <RadioButton x:Name="TabPricing"
                             Style="{StaticResource TabRadio}"
                             Content="Shopee 定价"
                             Checked="TabPricing_Checked"/>
                <RadioButton x:Name="TabJoom"
                             Style="{StaticResource TabRadio}"
                             Content="JOOM"
                             Checked="TabJoom_Checked"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,1,1"
                CornerRadius="0,0,6,6"
                Padding="12">
            <Grid>
                <views:DianxiaomiSearchView x:Name="SearchView"/>
                <views:ShopeePricingView x:Name="PricingView" Visibility="Collapsed"/>
                <views:JoomPricingView x:Name="JoomView" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <DockPanel Grid.Row="3" Margin="4,10,4,0">
            <TextBlock x:Name="CountText"
                       DockPanel.Dock="Right"
                       Foreground="{StaticResource MutedBrush}"
                       Margin="16,0,0,0"
                       Text="有效 0 行 · 已算 0 行"/>
            <TextBlock x:Name="ShortcutHint"
                       DockPanel.Dock="Right"
                       Foreground="{StaticResource MutedBrush}"
                       Text="F5 计算 | Ctrl+E 导出"/>
            <TextBlock x:Name="StatusText"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"
                       Text="就绪：请先在「店小秘搜索」登录并导出 Cookie。"/>
        </DockPanel>
    </Grid>
</Window>
