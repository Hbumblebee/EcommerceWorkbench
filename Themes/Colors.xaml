<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Modern light workspace palette. Semantic keys keep feature views independent of raw colors. -->
    <Color x:Key="CanvasColor">#F4F6FA</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#F8FAFC</Color>
    <Color x:Key="BorderColor">#E2E8F0</Color>
    <Color x:Key="BorderStrongColor">#CBD5E1</Color>
    <Color x:Key="AccentColor">#2563EB</Color>
    <Color x:Key="AccentHoverColor">#1D4ED8</Color>
    <Color x:Key="AccentSoftColor">#EFF6FF</Color>
    <Color x:Key="BrandColor">#EA580C</Color>
    <Color x:Key="BrandHoverColor">#C2410C</Color>
    <Color x:Key="TextColor">#172033</Color>
    <Color x:Key="MutedColor">#64748B</Color>
    <Color x:Key="SubtleColor">#94A3B8</Color>
    <Color x:Key="InputColor">#FFF9E8</Color>
    <Color x:Key="ResultColor">#ECFDF3</Color>
    <Color x:Key="SuccessColor">#16804A</Color>
    <Color x:Key="SuccessSoftColor">#ECFDF3</Color>
    <Color x:Key="WarningColor">#C65D08</Color>
    <Color x:Key="DangerColor">#B42318</Color>
    <Color x:Key="GhostColor">#F1F5F9</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource CanvasColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="BrandOrangeBrush" Color="{StaticResource BrandColor}"/>
    <SolidColorBrush x:Key="BrandHoverBrush" Color="{StaticResource BrandHoverColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="{StaticResource SubtleColor}"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource InputColor}"/>
    <SolidColorBrush x:Key="KeyResultBgBrush" Color="{StaticResource ResultColor}"/>
    <SolidColorBrush x:Key="OkGreenBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}"/>
    <SolidColorBrush x:Key="WarnAmberBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="GhostBgBrush" Color="{StaticResource GhostColor}"/>

    <DropShadowEffect x:Key="CardShadow"
                      Color="#160F172A"
                      BlurRadius="18"
                      ShadowDepth="2"
                      Opacity="0.55"/>
</ResourceDictionary>
